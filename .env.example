# ==============================================================================
# RepoLens v1 Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `backend/.env` for backend execution, or reference individual
# variables in your runtime environment.
# For frontend configuration, set `NEXT_PUBLIC_API_BASE_URL` in `frontend/.env.local`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="RepoLens"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# OpenAPI / Swagger documentation access:
# - Omitted (default): Enabled automatically in development, disabled automatically in production
# - Explicit true: Deliberate opt-in (e.g., internal staging environment)
# - Explicit false: Forced off in any environment
# ENABLE_API_DOCS=true

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# SQLite is used by default for zero-dependency local development and testing.
# For PostgreSQL / pgvector deployments, provide a standard postgresql:// URL.
DATABASE_URL="sqlite:///./repolens.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/repolens"

# Enable PostgreSQL pgvector integration (requires PostgreSQL + pgvector extension)
ENABLE_PGVECTOR=false

# ------------------------------------------------------------------------------
# 3. Server, Network & CORS Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated). In production, wildcard (*) is prohibited.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Trusted Host header middleware (comma-separated). In production, wildcard (*) is prohibited.
TRUSTED_HOSTS="localhost,127.0.0.1,testserver"

# ------------------------------------------------------------------------------
# 4. Authentication, Sessions & Security (Phase 8)
# ------------------------------------------------------------------------------
# Session duration in seconds (default: 86400 = 24 hours)
AUTH_SESSION_TTL_SECONDS=86400

# Failed login attempt lockout controls
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Session cookie properties
AUTH_COOKIE_NAME="repolens_session"

# CRITICAL FOR PRODUCTION: AUTH_COOKIE_SECURE must be True in production environments (HTTPS).
# In local development over HTTP, leave False.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"
AUTH_COOKIE_DOMAIN=""

# CSRF Double-Submit Protection
CSRF_COOKIE_NAME="repolens_csrf"
CSRF_HEADER_NAME="X-CSRF-Token"

# ------------------------------------------------------------------------------
# 5. User Daily Quotas (Phase 8)
# ------------------------------------------------------------------------------
MAX_DAILY_SCANS_PER_USER=20
MAX_DAILY_CHANGE_ANALYSES_PER_USER=50
MAX_DAILY_PATCH_GENERATIONS_PER_USER=50

# ------------------------------------------------------------------------------
# 6. LLM Provider API Keys & Base URLs
# ------------------------------------------------------------------------------
# Provide at least one API key for AI-assisted reasoning/review.
# Pure static analysis and structural AST diffing operate deterministically
# without LLM keys.
GEMINI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
HUGGINGFACE_API_KEY=""

GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1"

# Canonical Policy Model Mappings
MODEL_ARCHITECTURE="gemini-3.7-flash"
MODEL_INTEGRATION_CODE="Qwen/Qwen3-Coder-Next"
MODEL_BUG_REASONING="poolside/laguna-xs-2.1"
MODEL_SECURITY_REASONING="openai/gpt-oss-120b"
MODEL_LIGHTWEIGHT_CLASSIFICATION="openai/gpt-oss-20b"
MODEL_VERIFICATION="nvidia/nemotron-3-ultra-550b-a55b"

# LLM Gateway Execution Settings
LLM_DEFAULT_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 7. Embedding Models & Checkpoint Persistence
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_PRIMARY="nvidia/nv-embedcode-7b-v1"
EMBEDDING_MODEL_FALLBACK="Qwen/Qwen3-Embedding-0.6B"
EMBEDDING_DIMENSIONS_PRIMARY=4096
EMBEDDING_DIMENSIONS_FALLBACK=1024

# Durable LangGraph workflow execution checkpointer database file
CHECKPOINT_DB_FILE="checkpoints.db"

# ------------------------------------------------------------------------------
# 8. Repository Ingestion Limits & Confinement
# ------------------------------------------------------------------------------
CLONE_TIMEOUT_SECONDS=120
MAX_REPO_FILES=5000
MAX_FILE_SIZE_BYTES=1048576       # 1 MB maximum per file
MAX_TOTAL_SOURCE_BYTES=52428800   # 50 MB global source budget
MAX_SCAN_DURATION_SECONDS=300     # 5 minutes maximum scan lifecycle timeout
ALLOWED_EXTENSIONS=".py,.js,.ts,.tsx,.jsx,.json,.yaml,.yml,.toml,.md,.txt,.cfg,.ini,.html,.css,.sql,.sh,.dockerfile,.env.example"

# ------------------------------------------------------------------------------
# 9. Deterministic Static Scanners
# ------------------------------------------------------------------------------
# Path to CLI binaries. If unavailable on PATH, adapters degrade gracefully.
SEMGREP_PATH="semgrep"
TRIVY_PATH="trivy"
OSV_SCANNER_PATH="osv-scanner"
SCANNER_TIMEOUT_SECONDS=60
SEMGREP_ENABLED=true
TRIVY_ENABLED=true
OSV_SCANNER_ENABLED=true

# ------------------------------------------------------------------------------
# 10. Safe GitHub Delivery & Review Publication (Phase 5 & Phase 7)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo/contents scope.
# Note: Public repository/PR analysis is credential-free.
# GITHUB_TOKEN is only used by OPERATOR users when explicit write feature flags are enabled.
GITHUB_TOKEN=""

# Phase 5: Feature flag for delivering approved remediation patches as pull requests.
# Default: false (safe read-only mode).
GITHUB_DELIVERY_ENABLED=false

# Phase 7: Feature flag for publishing PR change reviews as COMMENT events.
# Default: false (safe preview-only mode). Never uses APPROVE or REQUEST_CHANGES.
GITHUB_PR_REVIEW_WRITE_ENABLED=false
MAX_REVIEW_INLINE_COMMENTS=20
MAX_REVIEW_BODY_CHARS=50000

# ------------------------------------------------------------------------------
# 11. Frontend Configuration
# ------------------------------------------------------------------------------
# Configure in `frontend/.env.local`
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
