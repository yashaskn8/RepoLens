# Backend Configuration
PROJECT_NAME="RepoLens"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default, portable to PostgreSQL)
DATABASE_URL="sqlite:///./repolens.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/repolens"

# Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# LLM Provider API Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""
NVIDIA_API_KEY=""
HUGGINGFACE_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
OPENROUTER_API_KEY=""

# LLM Provider Base URLs (Defaults)
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
HUGGINGFACE_BASE_URL="https://router.huggingface.co/v1"
CLOUDFLARE_BASE_URL="https://api.cloudflare.com/client/v4"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
COHERE_BASE_URL="https://api.cohere.com/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Task-Aware Multi-Provider Model Defaults
CLOUDFLARE_DEFAULT_MODEL="@cf/meta/llama-3.1-8b-instruct"
MISTRAL_DEFAULT_MODEL="mistral-small-latest"
COHERE_EMBEDDING_MODEL="embed-english-v3.0"
COHERE_RERANK_MODEL="rerank-v3.5"
OPENROUTER_DEFAULT_MODEL="meta-llama/llama-3.2-3b-instruct:free"

# Routing Optimization Thresholds
ROUTER_RERANK_MIN_CANDIDATES=3
ROUTER_COMPLEXITY_CONTEXT_THRESHOLD=2000

# Task Policy Model Mappings
MODEL_ARCHITECTURE="gemini-3.7-flash"
MODEL_INTEGRATION_CODE="Qwen/Qwen3-Coder-Next"
MODEL_BUG_REASONING="poolside/laguna-xs-2.1"
MODEL_SECURITY_REASONING="openai/gpt-oss-120b"
MODEL_LIGHTWEIGHT_CLASSIFICATION="openai/gpt-oss-20b"
MODEL_VERIFICATION="nvidia/nemotron-3-ultra-550b-a55b"

# LLM Gateway Execution Settings
LLM_DEFAULT_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# Shared workflow cloud-use governor (local/cache/deterministic work is free)
AI_ECONOMY_MODE="auto"
AI_ECONOMY_STRICT_MAX_CLOUD_CALLS=3
AI_ECONOMY_STRICT_MAX_CLOUD_TOKENS=12000
AI_ECONOMY_AUTO_MAX_CLOUD_CALLS=8
AI_ECONOMY_AUTO_MAX_CLOUD_TOKENS=40000
AI_ECONOMY_QUALITY_MAX_CLOUD_CALLS=16
AI_ECONOMY_QUALITY_MAX_CLOUD_TOKENS=100000

# Deterministic Scanner Settings
SEMGREP_PATH="semgrep"
TRIVY_PATH="trivy"
OSV_SCANNER_PATH="osv-scanner"
SCANNER_TIMEOUT_SECONDS=60
SEMGREP_ENABLED=true
TRIVY_ENABLED=true
OSV_SCANNER_ENABLED=true

# Embedding Model Settings
EMBEDDING_MODEL_PRIMARY="nvidia/nv-embedcode-7b-v1"
EMBEDDING_MODEL_FALLBACK="Qwen/Qwen3-Embedding-0.6B"
EMBEDDING_DIMENSIONS_PRIMARY=4096
EMBEDDING_DIMENSIONS_FALLBACK=1024

# LangGraph Checkpoint Settings
CHECKPOINT_DB_FILE="checkpoints.db"

# Redis Cloud / Runtime Caching Infrastructure (Phase 1)
# Supports rediss:// (TLS) and redis:// schemes.
# Leave commented out or empty for graceful degradation (offline fallback).
# REDIS_URL="rediss://default:your-password@your-redis-cloud-host:6379"
# REDIS_MAX_CONNECTIONS=10
# REDIS_TIMEOUT_SECONDS=2.0
# REDIS_DEFAULT_CACHE_TTL_SECONDS=3600
